# Copy this file to .env.local and fill in the two values below.
# Find them in Supabase: Project Settings -> API
# NEXT_PUBLIC_ vars are safe to expose to the browser -- the anon key
# is meant to be public; real security comes from the Row Level Security
# policies already in daily_digest_schema.sql, not from hiding this key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
